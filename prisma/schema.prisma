generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  passwordHash            String
  firstName               String
  lastName                String
  emailVerifiedAt         DateTime?               @db.Timestamptz(3)
  emailVerificationSentAt DateTime?               @db.Timestamptz(3)
  passwordResetSentAt     DateTime?               @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)
  businesses              Business[]
  sessions                Session[]
  emailVerificationToken  EmailVerificationToken?
  passwordResetToken      PasswordResetToken?
}

model PasswordResetToken {
  userId    String   @id
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model EmailVerificationToken {
  userId    String   @id
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @db.VarChar(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Business {
  id          String     @id @default(cuid())
  ownerId     String
  name        String
  slug        String     @unique
  description String?
  logoUrl     String?
  phone       String?
  currency    String     @default("NGN") @db.VarChar(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  customers   Customer[]
  services    Service[]
  invoices    Invoice[]
  payments    Payment[]

  @@index([ownerId])
}

model Customer {
  id         String    @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  notes      String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invoices   Invoice[]

  // Enables a composite foreign key to prevent cross-business invoices.
  @@unique([id, businessId])
  @@index([businessId, createdAt])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(19, 4)
  currency    String   @default("NGN") @db.VarChar(3)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, active])
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  customerId    String
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(19, 4)
  total         Decimal       @db.Decimal(19, 4)
  currency      String        @default("NGN") @db.VarChar(3)
  dueDate       DateTime?     @db.Date
  notes         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer      Customer      @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([id, businessId])
  @@unique([businessId, invoiceNumber])
  @@index([businessId, status, createdAt])
  @@index([customerId, businessId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  name        String
  description String?
  quantity    Decimal @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(19, 4)
  total       Decimal @db.Decimal(19, 4)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model Payment {
  id                String        @id @default(cuid())
  businessId        String
  invoiceId         String
  amount            Decimal       @db.Decimal(19, 4)
  currency          String        @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  provider          String        @default("bachs")
  providerReference String?
  checkoutUrl       String?
  paidAt            DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invoice           Invoice       @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([businessId, status, createdAt])
  @@index([invoiceId, businessId])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payloadHash     String
  processedAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([provider, externalEventId])
}
