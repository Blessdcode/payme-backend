NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pay_me:pay_me_local@localhost:5432/pay_me?schema=public
# Supabase alternative: replace DATABASE_URL with the Session pooler URI
# from your project's Connect dialog (port 5432). See docs/supabase.md.
# Keep the real database password only in .env, never in frontend variables.
FRONTEND_URL=http://localhost:5173
# Must match DATABASE_URL when using the local Compose database.
POSTGRES_USER=pay_me
POSTGRES_PASSWORD=pay_me_local
POSTGRES_DB=pay_me
POSTGRES_PORT=5432
# Generate two different random secrets of at least 32 characters.
# See docs/authentication.md for a command that fills missing local secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Email verification is opt-in until a delivery provider is configured.
EMAIL_PROVIDER=disabled
# When EMAIL_PROVIDER=smtp, configure your SMTP provider privately.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=verify@your-domain.com
# Port 465 requires SMTP_SECURE=true; 587 uses mandatory STARTTLS.
# Bachs variables become required when its module is implemented.
# BACHS_SECRET_KEY=
# BACHS_WEBHOOK_SECRET=
# BACHS_BASE_URL=
