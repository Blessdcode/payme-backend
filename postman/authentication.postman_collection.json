    {
      "name": "Forgot and reset password (disposable account)",
      "description": "Copy the token from the email link fragment into Vault pay-me-reset-token. Configure pay-me-reset-password with a different password of at least 8 characters. Successful reset revokes all sessions. Update pay-me-password afterwards.",
      "item": [
        {
          "name": "Request recovery link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vault:pay-me-email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 202', function () { pm.response.to.have.status(202); });"
