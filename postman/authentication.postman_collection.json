{
  "info": {
    "name": "Pay Me ? Authentication backend",
    "description": "Backend-first authentication checks. Supply email, password, and verification token through your local Postman Vault. All POST requests send the configured frontend Origin. The cookie jar retains httpOnly cookies; no token logging is included. Verification requests require configured delivery. Do not run registration against an account you want to keep unchanged.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:5173"
    }
  ],
  "item": [
    {
      "name": "Session authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vault:pay-me-email}}\",\n  \"password\": \"{{vault:pay-me-password}}\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Owner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(201); });",
                  "pm.test('No credentials in response', function () { const b = pm.response.json(); const d = b.data || {}; pm.expect('passwordHash' in d || 'accessToken' in d || 'refreshToken' in d || 'token' in d).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vault:pay-me-email}}\",\n  \"password\": \"{{vault:pay-me-password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(200); });",
                  "pm.test('No credentials in response', function () { const b = pm.response.json(); const d = b.data || {}; pm.expect('passwordHash' in d || 'accessToken' in d || 'refreshToken' in d || 'token' in d).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(200); });",
                  "pm.test('No credentials in response', function () { const b = pm.response.json(); const d = b.data || {}; pm.expect('passwordHash' in d || 'accessToken' in d || 'refreshToken' in d || 'token' in d).to.eql(false); });",
                  "pm.test('Verification status present', function () { pm.expect(Object.hasOwn(pm.response.json().data, 'emailVerifiedAt')).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(200); });",
                  "pm.test('No credentials in response', function () { const b = pm.response.json(); const d = b.data || {}; pm.expect('passwordHash' in d || 'accessToken' in d || 'refreshToken' in d || 'token' in d).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user after logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Email verification",
      "item": [
        {
          "name": "Request or resend verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/email-verification/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vault:pay-me-email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(202); });",
                  "pm.test('No credentials in response', function () { const b = pm.response.json(); const d = b.data || {}; pm.expect('passwordHash' in d || 'accessToken' in d || 'refreshToken' in d || 'token' in d).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown account gets the same accepted response",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/email-verification/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"unknown-account@example.invalid\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(202); });",
                  "pm.test('Generic response', function () { pm.expect(pm.response.json().data.message).to.eql('If the account is eligible, a verification email will be sent.'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm token from your mailbox",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/email-verification/confirm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{vault:pay-me-verification-token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(200); });",
                  "pm.test('No credentials in response', function () { const b = pm.response.json(); const d = b.data || {}; pm.expect('passwordHash' in d || 'accessToken' in d || 'refreshToken' in d || 'token' in d).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay the same token is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/email-verification/confirm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{vault:pay-me-verification-token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed token is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/email-verification/confirm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"invalid\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verification status after login",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(200); });",
                  "pm.test('Email is verified', function () { pm.expect(typeof pm.response.json().data.emailVerifiedAt).to.eql('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
